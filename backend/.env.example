# Variables de entorno del backend (correr la API por separado).
# cp .env.example .env

PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mundial

# Seguridad
JWT_SECRET=un-secreto-largo-y-aleatorio-cambialo
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# Usuario administrador inicial
ADMIN_USER=admin
ADMIN_PASSWORD=admin1234
