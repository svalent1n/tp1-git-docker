# Variables de entorno del stack (Docker Compose).
# Copiá este archivo a ".env" y ajustá los valores. NUNCA subas el .env real al repo.
# cp .env.example .env

# --- Seguridad / Autenticación (backend) ---
JWT_SECRET=un-secreto-largo-y-aleatorio-cambialo
JWT_EXPIRES_IN=2h

# Credenciales del usuario administrador que se crea al arrancar la API.
ADMIN_USER=admin
ADMIN_PASSWORD=admin1234

# --- Frontend ---
# URL de la API que consume el frontend (se usa al construir la imagen).
VITE_API_URL=http://localhost:3000/api
